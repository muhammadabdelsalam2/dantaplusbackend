{
  "info": {
    "name": "DantaPlus Super Admin Settings",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Settings",
      "item": [
        {
          "name": "Save Changes (All Settings)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/owner/settings/save-all",
            "body": {
              "mode": "raw",
              "raw": "{\"global\":{\"system_name\":\"Denta+ SaaS\",\"support_email\":\"support@dentaplus.com\",\"support_phone\":\"1-800-555-DENT\",\"timezone\":\"America/New_York\",\"default_language\":\"English\",\"default_currency\":\"USD\"},\"whatsapp\":{\"device_status\":\"Connected\",\"message_templates\":[{\"key\":\"queue_arrival\",\"name\":\"Queue Arrival\",\"content\":\"Hello {{patient_name}}, your turn is approaching at {{clinic_name}}.\"}]},\"billing_plans\":{\"premium\":{\"plan_name\":\"Premium\",\"yearly_price\":990,\"monthly_price\":99,\"description\":\"All features for large-scale operations.\"},\"standard\":{\"plan_name\":\"Standard\",\"yearly_price\":590,\"monthly_price\":59,\"description\":\"Advanced features for growing clinics.\"},\"basic\":{\"plan_name\":\"Basic\",\"yearly_price\":290,\"monthly_price\":29,\"description\":\"Essential features for small clinics.\"}},\"user_management\":{\"allow_new_signups\":true,\"allow_trial_accounts\":true},\"notifications\":{\"enable_system_email_notifications\":true,\"enable_sms_whatsapp_notifications\":false,\"notification_sounds\":true},\"backup\":{\"auto_backup_frequency\":\"daily\"},\"customization\":{\"dashboard_theme\":\"auto\",\"accent_color\":\"#6C5CE7\"}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "My Profile",
          "item": [
            {
              "name": "Get Profile",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/owner/settings/profile"
              }
            },
            {
              "name": "Save Profile Changes",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/owner/settings/profile",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "full_name",
                      "value": "Moamen Ahmed",
                      "type": "text"
                    },
                    {
                      "key": "username",
                      "value": "moamenahmed54321",
                      "type": "text"
                    },
                    {
                      "key": "email",
                      "value": "moamenahmed54321@gmail.com",
                      "type": "text"
                    }
                  ]
                }
              }
            },
            {
              "name": "Change Photo",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/owner/settings/profile/photo",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "file",
                      "type": "file",
                      "src": ""
                    }
                  ]
                }
              }
            },
            {
              "name": "Update Password",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/owner/settings/password",
                "body": {
                  "mode": "raw",
                  "raw": "{\"current_password\":\"password123\",\"new_password\":\"newPassword123\",\"new_password_confirmation\":\"newPassword123\"}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "name": "General Settings",
          "item": [
            {
              "name": "Get General Settings",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/owner/settings/global"
              }
            },
            {
              "name": "Get Timezones",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/owner/settings/timezones"
              }
            }
          ]
        },
        {
          "name": "WhatsApp Integration",
          "item": [
            {
              "name": "Get WhatsApp Settings",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/owner/settings/whatsapp"
              }
            },
            {
              "name": "Reconnect Device",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/owner/settings/whatsapp/reconnect"
              }
            },
            {
              "name": "Send Test Message",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/owner/settings/whatsapp/test-message",
                "body": {
                  "mode": "raw",
                  "raw": "{\"to\":\"+201000000000\",\"message\":\"Test message from Denta+\"}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "List Message Templates",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/owner/settings/whatsapp/templates"
              }
            }
          ]
        },
        {
          "name": "Subscription & Billing",
          "item": [
            {
              "name": "Get Billing Plans",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/owner/settings/billing/plans"
              }
            },
            {
              "name": "View All Active Subscriptions",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/owner/invoices"
              }
            }
          ]
        },
        {
          "name": "User Management",
          "item": [
            {
              "name": "Get User Management Settings",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/owner/settings/user-management"
              }
            }
          ]
        },
        {
          "name": "Notification Settings",
          "item": [
            {
              "name": "Get Notification Settings",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/owner/settings/notifications"
              }
            }
          ]
        },
        {
          "name": "Backup & System",
          "item": [
            {
              "name": "Get Backup Settings",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/owner/settings/backup"
              }
            },
            {
              "name": "Create Manual Backup Now",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/owner/settings/backup/manual"
              }
            }
          ]
        },
        {
          "name": "System Customization",
          "item": [
            {
              "name": "Get Customization Settings",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/owner/settings/customization"
              }
            }
          ]
        }
      ]
    }
  ]
}
