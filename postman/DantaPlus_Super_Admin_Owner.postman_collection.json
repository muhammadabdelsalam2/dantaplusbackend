{
  "info": {
    "name": "DantaPlus Super Admin Owner APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" },
    { "key": "clinic_id", "value": "1" },
    { "key": "user_id", "value": "1" },
    { "key": "company_id", "value": "1" },
    { "key": "product_id", "value": "1" },
    { "key": "order_id", "value": "1" },
    { "key": "lab_id", "value": "1" },
    { "key": "maintenance_company_id", "value": "1" },
    { "key": "maintenance_request_id", "value": "1" },
    { "key": "alert_id", "value": "1" },
    { "key": "invoice_id", "value": "INV-CL-0001" },
    { "key": "notification_id", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Dashboard",
      "item": [
        { "name": "Owner Dashboard", "request": { "method": "GET", "url": "{{base_url}}/owner/dashboard" } },
        { "name": "Owner Analytics", "request": { "method": "GET", "url": "{{base_url}}/owner/analytics" } }
      ]
    },
    {
      "name": "Clinics",
      "item": [
        { "name": "List Clinics", "request": { "method": "GET", "url": "{{base_url}}/owner/clinics?search=&status=&subscription_plan=&per_page=15" } },
        {
          "name": "Create Clinic",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "owner_name", "value": "Dr. Owner", "type": "text" },
              { "key": "name", "value": "New Dental Clinic", "type": "text" },
              { "key": "phone", "value": "+201000000000", "type": "text" },
              { "key": "email", "value": "clinic.admin@example.com", "type": "text" },
              { "key": "address", "value": "Clinic Address", "type": "text" },
              { "key": "admin_password", "value": "password123", "type": "text" },
              { "key": "subscription_plan", "value": "Standard", "type": "text" },
              { "key": "max_users", "value": "15", "type": "text" },
              { "key": "max_branches", "value": "1", "type": "text" },
              { "key": "payment_method", "value": "Stripe", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/clinics"
          }
        },
        { "name": "Show Clinic", "request": { "method": "GET", "url": "{{base_url}}/owner/clinics/{{clinic_id}}?include=users,branches" } },
        {
          "name": "Update Clinic",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "owner_name", "value": "Dr. Owner Updated", "type": "text" },
              { "key": "name", "value": "Updated Dental Clinic", "type": "text" },
              { "key": "phone", "value": "+201111111111", "type": "text" },
              { "key": "email", "value": "clinic.updated@example.com", "type": "text" },
              { "key": "address", "value": "Updated Address", "type": "text" },
              { "key": "subscription_plan", "value": "Premium", "type": "text" },
              { "key": "payment_method", "value": "PayPal", "type": "text" },
              { "key": "max_users", "value": "25", "type": "text" },
              { "key": "max_branches", "value": "2", "type": "text" },
              { "key": "status", "value": "Active", "type": "text" },
              { "key": "start_date", "value": "2026-07-01", "type": "text" },
              { "key": "expiry_date", "value": "2026-08-01", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/clinics/{{clinic_id}}"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "List Users", "request": { "method": "GET", "url": "{{base_url}}/owner/users?q=&role=&status=&per_page=15" } },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "name", "value": "John Carter", "type": "text" },
              { "key": "email", "value": "john.carter@example.com", "type": "text" },
              { "key": "phone", "value": "+201222222222", "type": "text" },
              { "key": "password", "value": "password123", "type": "text" },
              { "key": "is_active", "value": "true", "type": "text" },
              { "key": "role", "value": "Doctor", "type": "text" },
              { "key": "lab_id", "value": "", "type": "text" },
              { "key": "lab_name", "value": "", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/users"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "body": { "mode": "formdata", "formdata": [
              { "key": "name", "value": "John Carter Updated", "type": "text" },
              { "key": "email", "value": "john.updated@example.com", "type": "text" },
              { "key": "phone", "value": "+201333333333", "type": "text" },
              { "key": "password", "value": "", "type": "text" },
              { "key": "is_active", "value": "true", "type": "text" },
              { "key": "role", "value": "Receptionist", "type": "text" },
              { "key": "lab_id", "value": "", "type": "text" },
              { "key": "lab_name", "value": "", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/users/{{user_id}}"
          }
        }
      ]
    },
    {
      "name": "Material Companies",
      "item": [
        { "name": "List Companies", "request": { "method": "GET", "url": "{{base_url}}/owner/material-market?search=&country=&status=&per_page=15" } },
        {
          "name": "Create Company",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "name", "value": "3M Dental", "type": "text" },
              { "key": "email", "value": "dental@3m.com", "type": "text" },
              { "key": "admin_password", "value": "password123", "type": "text" },
              { "key": "admin_is_active", "value": "true", "type": "text" },
              { "key": "commission_percentage", "value": "10", "type": "text" },
              { "key": "description", "value": "A global leader in dental products.", "type": "text" },
              { "key": "logo", "type": "file", "src": "" },
              { "key": "website", "value": "https://www.3m.com/3M/en_US/dental-us", "type": "text" },
              { "key": "phone", "value": "1-800-634-2249", "type": "text" },
              { "key": "address", "value": "3M Center, St. Paul, MN 55144", "type": "text" },
              { "key": "city", "value": "St. Paul, MN", "type": "text" },
              { "key": "country", "value": "United States", "type": "text" },
              { "key": "categories[]", "value": "Surgical", "type": "text" },
              { "key": "categories[]", "value": "Orthodontic", "type": "text" },
              { "key": "categories[]", "value": "Restorative", "type": "text" },
              { "key": "categories[]", "value": "Cosmetic", "type": "text" },
              { "key": "categories[]", "value": "Endodontics", "type": "text" },
              { "key": "categories[]", "value": "Prosthodontics", "type": "text" },
              { "key": "status", "value": "Active", "type": "text" },
              { "key": "rating", "value": "5", "type": "text" },
              { "key": "is_featured", "value": "true", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/material-market"
          }
        },
        { "name": "Show Company", "request": { "method": "GET", "url": "{{base_url}}/owner/material-market/{{company_id}}" } }
      ]
    },
    {
      "name": "Material Products",
      "item": [
        { "name": "List Products", "request": { "method": "GET", "url": "{{base_url}}/owner/material-market/{{company_id}}/products?search=&category=&status=&per_page=15" } },
        {
          "name": "Add Product",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "image", "type": "file", "src": "" },
              { "key": "brand", "value": "Filtek", "type": "text" },
              { "key": "name", "value": "Filtek Supreme Ultra Universal Restorative", "type": "text" },
              { "key": "description", "value": "Composite restorative material.", "type": "text" },
              { "key": "stock", "value": "50", "type": "text" },
              { "key": "price", "value": "150", "type": "text" },
              { "key": "category", "value": "Composites", "type": "text" },
              { "key": "status", "value": "active", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/material-market/{{company_id}}/products"
          }
        },
        { "name": "Export Products Public", "auth": { "type": "noauth" }, "request": { "method": "GET", "url": "{{base_url}}/owner/material-market/{{company_id}}/products/export" } }
      ]
    },
    {
      "name": "Material Orders",
      "item": [
        { "name": "List Orders", "request": { "method": "GET", "url": "{{base_url}}/owner/material-orders?search=&status=&per_page=15" } },
        { "name": "Show Order", "request": { "method": "GET", "url": "{{base_url}}/owner/material-orders/{{order_id}}" } }
      ]
    },
    {
      "name": "Commissions",
      "item": [
        { "name": "List Commissions", "request": { "method": "GET", "url": "{{base_url}}/owner/mc-commissions?search=&status=&per_page=15" } },
        {
          "name": "Set Commission",
          "request": {
            "method": "PATCH",
            "body": { "mode": "formdata", "formdata": [
              { "key": "commission_percentage", "value": "10", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/mc-commissions/{{company_id}}"
          }
        }
      ]
    },
    {
      "name": "Dental Labs",
      "item": [
        { "name": "List Labs", "request": { "method": "GET", "url": "{{base_url}}/owner/labs?search=&status=&per_page=15" } },
        { "name": "Show Lab", "request": { "method": "GET", "url": "{{base_url}}/owner/labs/{{lab_id}}?include=services,reviews,performance" } },
        {
          "name": "Create Lab",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "name", "value": "Precision Dental Labs", "type": "text" },
              { "key": "contact_person", "value": "Mike Ross", "type": "text" },
              { "key": "city", "value": "Metropolis", "type": "text" },
              { "key": "phone", "value": "+201000000001", "type": "text" },
              { "key": "email", "value": "lab@example.com", "type": "text" },
              { "key": "avg_delivery_days", "value": "4", "type": "text" },
              { "key": "status", "value": "Active", "type": "text" },
              { "key": "rating", "value": "5", "type": "text" },
              { "key": "admin_name", "value": "Mike Ross", "type": "text" },
              { "key": "admin_email", "value": "lab.admin@example.com", "type": "text" },
              { "key": "admin_password", "value": "password123", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/labs"
          }
        }
      ]
    },
    {
      "name": "Equipment Maintenance",
      "item": [
        { "name": "List Maintenance Requests", "request": { "method": "GET", "url": "{{base_url}}/owner/equipment-maintenance/requests?search=&status=&clinic_id=&company_id=&per_page=15" } },
        { "name": "Show Request Details", "request": { "method": "GET", "url": "{{base_url}}/owner/equipment-maintenance/requests/{{maintenance_request_id}}" } },
        {
          "name": "Update Request Editable Fields",
          "request": {
            "method": "PATCH",
            "body": { "mode": "formdata", "formdata": [
              { "key": "status", "value": "In Progress", "type": "text" },
              { "key": "assigned_company_id", "value": "{{maintenance_company_id}}", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/equipment-maintenance/requests/{{maintenance_request_id}}"
          }
        },
        { "name": "List Maintenance Companies", "request": { "method": "GET", "url": "{{base_url}}/owner/equipment-maintenance/companies?search=&status=&per_page=15" } },
        { "name": "Show Company Details", "request": { "method": "GET", "url": "{{base_url}}/owner/equipment-maintenance/companies/{{maintenance_company_id}}" } },
        {
          "name": "Add Maintenance Company",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "contact_person", "value": "John Doe", "type": "text" },
              { "key": "company_name", "value": "SmileTech Repair", "type": "text" },
              { "key": "email", "value": "john@smiletech.example", "type": "text" },
              { "key": "phone", "value": "555-8080", "type": "text" },
              { "key": "status", "value": "Active", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/equipment-maintenance/companies"
          }
        },
        {
          "name": "Update Company Status",
          "request": {
            "method": "PATCH",
            "body": { "mode": "formdata", "formdata": [
              { "key": "status", "value": "Inactive", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/equipment-maintenance/companies/{{maintenance_company_id}}/status"
          }
        },
        {
          "name": "Mark Alert As Reviewed",
          "request": { "method": "PATCH", "url": "{{base_url}}/owner/equipment-maintenance/alerts/{{alert_id}}/review" }
        }
      ]
    },
    {
      "name": "Subscriptions Invoices",
      "item": [
        { "name": "Invoices Dashboard Cards", "request": { "method": "GET", "url": "{{base_url}}/owner/invoices/dashboard" } },
        { "name": "List Invoices", "request": { "method": "GET", "url": "{{base_url}}/owner/invoices?search=&status=&plan=&per_page=15" } },
        {
          "name": "Update Invoice Status",
          "request": {
            "method": "PATCH",
            "body": { "mode": "formdata", "formdata": [
              { "key": "status", "value": "Paid", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/invoices/{{invoice_id}}/status"
          }
        }
      ]
    },
    {
      "name": "Global Notifications Center",
      "item": [
        { "name": "List Notifications", "request": { "method": "GET", "url": "{{base_url}}/owner/notifications?tab=all&search=&per_page=15" } },
        {
          "name": "Create Notification",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "title", "value": "System Notice", "type": "text" },
              { "key": "message", "value": "This is a global notification.", "type": "text" },
              { "key": "priority", "value": "Normal", "type": "text" },
              { "key": "notification_type", "value": "Custom", "type": "text" },
              { "key": "delivery_methods[]", "value": "sms", "type": "text" },
              { "key": "delivery_methods[]", "value": "email", "type": "text" },
              { "key": "delivery_methods[]", "value": "in_app", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/notifications"
          }
        },
        {
          "name": "Test Live Notification",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "title", "value": "Real-Time Test", "type": "text" },
              { "key": "message", "value": "This is a test notification to demonstrate real-time updates.", "type": "text" },
              { "key": "priority", "value": "Normal", "type": "text" },
              { "key": "notification_type", "value": "System", "type": "text" },
              { "key": "delivery_methods[]", "value": "in_app", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/notifications/test"
          }
        },
        { "name": "Mark Notification Read", "request": { "method": "PATCH", "url": "{{base_url}}/owner/notifications/{{notification_id}}/read" } }
      ]
    },
    {
      "name": "Notification Logs",
      "item": [
        { "name": "List Notification Logs", "request": { "method": "GET", "url": "{{base_url}}/owner/notification-logs?from=&to=&channel=&doctor_user_id=&clinic_id=&per_page=15" } }
      ]
    },
    {
      "name": "Feedback Reports",
      "item": [
        { "name": "List Feedback Reports", "request": { "method": "GET", "url": "{{base_url}}/owner/feedback-reports?rating=&clinic_id=&per_page=15" } }
      ]
    },
    {
      "name": "Alerts Renewal",
      "item": [
        { "name": "List Alerts", "request": { "method": "GET", "url": "{{base_url}}/owner/alerts?tab=expiring_soon&search=&within_days=30&per_page=15" } },
        {
          "name": "Send Reminder",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "clinic_id", "value": "{{clinic_id}}", "type": "text" },
              { "key": "channel", "value": "email", "type": "text" },
              { "key": "message", "value": "Your subscription is close to renewal. Please complete payment.", "type": "text" }
            ] },
            "url": "{{base_url}}/owner/alerts/reminders"
          }
        }
      ]
    }
  ]
}
