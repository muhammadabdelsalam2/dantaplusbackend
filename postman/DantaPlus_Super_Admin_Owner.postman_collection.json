              { "key": "owner_name", "value": "Dr. Owner Updated", "type": "text" },
              { "key": "name", "value": "Updated Dental Clinic", "type": "text" },
              { "key": "phone", "value": "+201111111111", "type": "text" },
              { "key": "email", "value": "clinic.updated@example.com", "type": "text" },
              { "key": "address", "value": "Updated Address", "type": "text" },
              { "key": "subscription_plan", "value": "Premium", "type": "text" },
              { "key": "payment_method", "value": "PayPal", "type": "text" },
              { "key": "max_users", "value": "25", "type": "text" },
              { "key": "max_branches", "value": "2", "type": "text" },
