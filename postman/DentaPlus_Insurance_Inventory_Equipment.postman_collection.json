{
  "info": {
    "name": "DentaPlus Insurance Inventory Equipment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Insurance",
      "item": [
        {
          "name": "Claims",
          "item": [
            {
              "name": "List Claims",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/clinic/insurance/claims?status=approved&insurance_company_id=1&patient_id=1"
              }
            },
            {
              "name": "Add New Claim",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"insurance_company_id\": 1,\n  \"patient_id\": 1,\n  \"title\": \"Root Canal Therapy\",\n  \"service_date\": \"2026-08-02\",\n  \"gross_amount\": 960,\n  \"coverage_percentage\": 80,\n  \"status\": \"submitted\",\n  \"items\": [\n    { \"service_name\": \"Root Canal Therapy\", \"quantity\": 1, \"unit_price\": 960 }\n  ]\n}"
                },
                "url": "{{base_url}}/clinic/insurance/claims"
              }
            },
            {
              "name": "Update Claim Status - Approved with Limit",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"approved_with_limit\",\n  \"approved_amount\": 450\n}"
                },
                "url": "{{base_url}}/clinic/insurance/claims/1/status"
              }
            },
            {
              "name": "Claim Status Select",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/clinic/select/claim-statuses"
              }
