              "name": "Report Malfunction",
              "request": {
                "method": "POST",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "equipment_id", "value": "1", "type": "text" },
                    { "key": "equipment_name", "value": "Dental Chair Unit A", "type": "text" },
                    { "key": "malfunction_type", "value": "Leaking", "type": "text" },
                    { "key": "description", "value": "Water leakage under the chair base.", "type": "text" },
                    { "key": "urgency", "value": "Normal", "type": "text" },
                    { "key": "attachment", "type": "file", "src": "" }
                  ]
                },
                "url": "{{base_url}}/clinic/equipment/1/report"
              }
            }
          ]
        }
      ]
